{
  "name": "@lcg/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "reset": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@lcg/domain": "workspace:*",
    "@lcg/fixtures": "workspace:*",
    "@lcg/generation": "workspace:*",
    "@lcg/lesson-schema": "workspace:*",
    "@lcg/outline": "workspace:*",
    "drizzle-orm": "0.36.4",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.28.1"
  }
}
