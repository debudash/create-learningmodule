               ]
              }
             ]
            },
            {
             "type": "paragraph",
             "attrs": {
              "align": null
             },
             "content": [
              {
               "text": "Allow students to give a brief gist of the texts in their home language or in a mix of English and their home language to verify general understanding before they attempt items.",
               "type": "text",
               "marks": [
