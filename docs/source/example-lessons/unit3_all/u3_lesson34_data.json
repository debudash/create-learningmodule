                 "attrs": {
                  "color": "#bf360c"
                 }
                }
               ]
              },
              {
               "text": ", clarify that it means the detail that gives the strongest proof for the idea named in the question.",
               "type": "text",
               "marks": [
                {
                 "type": "textColor",
                 "attrs": {
                  "color": "#bf360c"
                 }
