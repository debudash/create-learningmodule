{
  "name": "newsela-lcg",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b && pnpm --filter @lcg/web typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration",
    "db:up": "docker compose up -d postgres",
    "format": "prettier --write .",
    "db:reset": "pnpm --filter @lcg/db reset",
    "dev": "pnpm --parallel --filter @lcg/web --filter @lcg/collab dev"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
